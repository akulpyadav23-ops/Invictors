# ==============================================================================
# FINAL OVERRIDE — ENVIRONMENT CONFIGURATION TEMPLATE
# Invictors Club · Dept. of CSE, VVCE Mysuru
# ==============================================================================

# Server Network Settings
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
TRUST_PROXY=false
CLUSTER_WORKERS=1
LOG_LEVEL=info

# Master Security Secrets (MUST BE CONFIGURED BEFORE RUNNING)
# ADMIN_PIN: Secret PIN to access Organizer Admin Portal (Min 8 chars, never default)
ADMIN_PIN=ChangeThisSecretAdminPin2026!

# EVENT_SALT: Cryptographic salt for answer hashing (Min 16 chars)
EVENT_SALT=ReplaceWithAStrong16CharSaltMinimum2026!

# SHARD_SECRET: Cryptographic key for Stage 5 member shard HMAC generation (Min 16 chars)
SHARD_SECRET=ReplaceWithSecretShardKey16CharsMinimum!

# VERIFY_SECRET: Key for HMAC verification code (Optional; derived from SHARD_SECRET if empty)
VERIFY_SECRET=

# Coordinators & PINs
# Comma-separated coordinator names displayed in registration dropdown
COORDINATORS=Arun,Divya,Kiran,Pooja,Rakshith

# Coordinator PINs (Format: Name1:Pin1,Name2:Pin2 or matching order, min 6 chars per PIN)
COORDINATOR_PINS=Arun:arun7090,Divya:divya9108,Kiran:kiran7975,Pooja:pooja2033,Rakshith:rakshith2034

# Game Engine & Penalties
MIN_TEAM_SIZE=3
MAX_TEAM_SIZE=4
TIME_CAP_MINUTES=90
TIME_CAP_ENFORCED=true
TAB_PENALTY_ENABLED=true
TAB_PENALTY_MINUTES=1
ADMIN_SESSION_LIMIT=2
ALLOW_NEW_TEAMS=false

# WARDEN AI Engine Mode (rules | llm; default rules for offline reliability)
WARDEN_MODE=rules
OPENAI_API_KEY=

# Database Settings
# Supported run mode: sqlite (single laptop/server offline mode)
DB_PROVIDER=sqlite
DB_PATH=./data/final_override.db
